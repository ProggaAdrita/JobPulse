PORT=3000
BASE_URL=http://localhost:3000
# Secret for POST /api/run (trigger the job fetch + emails manually)
ADMIN_KEY=change-me
# Daily run at 08:00 server time
CRON_SCHEDULE=0 8 * * *
# SMTP (Gmail: smtp.gmail.com / 587 / your address / an App Password). Leave SMTP_HOST empty to print emails to the console instead.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=JobPulse <you@example.com>
